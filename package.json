{
  "name": "offline-tools",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm build:image-codecs && vite",
    "build:image-codecs": "node scripts/build-image-codecs.mjs",
    "build": "pnpm build:image-codecs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm build && node --import tsx --test src/lib/png-strategy.test.ts src/workers/image-compress-worker.integration.test.ts tests/build-output.test.mjs",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "@jsquash/oxipng": "2.3.0",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "libimagequant-wasm": "0.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "tsx": "4.21.0",
    "vite": "8.0.13",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
